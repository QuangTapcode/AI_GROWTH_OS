# Worker env (W1-MY-01); env() có default nên chạy dev được ngay
APP_ENV=local
NODE_ENV=local
DATABASE_URL=
# API server base (MY-05): có giá trị → worker bật gateway recheck qua
# POST {API_BASE_URL}/v1/workspaces/{ws}/tools/execute trước khi publish CMS.
# Trống → bỏ qua recheck (hành vi cũ, chỉ dùng local không có gateway).
API_BASE_URL=
# Bearer token gọi API (dev token: dev_owner / dev_user_<uuid>_<role>).
WORKER_GATEWAY_TOKEN=dev_owner
GATEWAY_REQUEST_TIMEOUT_MS=5000
# pg-boss queue (Postgres)
QUEUE_HOST=127.0.0.1
QUEUE_PORT=5432
QUEUE_DATABASE=ai_growth_os
QUEUE_USER=ai_growth_dev
QUEUE_PASSWORD=
QUEUE_NAME=ai-growth-os-queue
# Worker caps (W1-PM-02)
AI_CONCURRENCY=1
MAX_PROVIDER_CALLS_PER_JOB=2
JOB_EXECUTION_TIMEOUT_MS=600000
# Heartbeat/lease + durable state (W1-MY-01)
HEARTBEAT_INTERVAL_MS=5000
HEARTBEAT_TTL_MS=30000
WORKER_STATE_DIR=.worker-state
# AI adapter: fake (mặc định, test nội bộ) | live (nối service Python theo CR-001)
AI_PROVIDER_MODE=fake
AI_SERVICE_BASE_URL=http://localhost:5000
INTERNAL_AI_AUTH_TOKEN=
# AI HTTP adapter (MY-01) — chỉ dùng khi AI_PROVIDER_MODE=live
AI_HTTP_POLL_INTERVAL_MS=1000
AI_HTTP_POLL_TIMEOUT_MS=600000
AI_HTTP_REQUEST_TIMEOUT_MS=30000
INTEGRATION_MODE=fake
# production chỉ bật sau khi OAuth/token đã được cấu hình; fake không gọi provider.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v20.0
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=
TIKTOK_DIRECT_POST_ENABLED=false
SOCIAL_REQUEST_TIMEOUT_MS=10000
# Thêm credentials CMS/GA4/GSC phía server theo adapter sau khi chốt.
# Same private token as API; enables automatic workspace scheduler ticks when API_BASE_URL is set.
AUTOMATION_INTERNAL_TOKEN=
