# Local development (public values only; never put service account JSON or tokens here).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1
NEXT_PUBLIC_SITE_ID=tripc-pilot


# Production / Cloudflare Pages: set to your own public site origin.
# NEXT_PUBLIC_SITE_URL=https://tripc-staging.pages.dev
# SITE_INDEXABLE=false

# Optional: Google Analytics web stream measurement ID, NOT the numeric GA4 API property ID.
# Loaded only after the visitor allows optional analytics.
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# GOOGLE_SITE_VERIFICATION=your-search-console-verification-value

# Required by npm run build:pages. Backend must expose /public/v1/sites/... routes.
# PILOT_API_ORIGIN=https://your-public-api.example.com
# Cloudflare Pages runtime variable (set in dashboard, not in browser code):
# PUBLIC_API_ORIGIN=https://your-public-api.example.com
