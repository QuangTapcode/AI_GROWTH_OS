{
  "name": "@ai-growth-os/api",
  "version": "0.1.0",
  "private": true,
  "description": "AI Growth OS core & public API modules (workspaces, sources, leads, public content, integrations)",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:workspaces": "tsx --env-file=.env scripts/test-workspaces.ts",
    "test:sources": "tsx --env-file=.env scripts/test-sources.ts",
    "test:boundary": "tsx --env-file=.env scripts/test-boundary-rag.ts",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts"
  },
  "dependencies": {
    "next": "^14.2.15",
    "pg": "^8.23.1",
    "pgvector": "^0.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
