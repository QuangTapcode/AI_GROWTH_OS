# ==============================================================================
# AI GROWTH OS — Environment Configuration Template (TQ-09)
# Copy this file to .env and fill in the values
# ==============================================================================

# Server configuration
PORT=4000
# APP_ENV chỉ nhận local | staging | test (src/lib/env.ts)
APP_ENV=local
INTEGRATION_MODE=fake
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# PostgreSQL Database (Host, Port, User, Password, DB Name)
# Local stack (infra/local): user ai_growth_dev, mật khẩu POSTGRES_PASSWORD trong infra/local/.env (URL-encode ký tự đặc biệt)
DATABASE_URL=postgres://ai_growth_dev:change_me@localhost:15432/ai_growth_os

# Internal AI HTTP Service
INTERNAL_AI_URL=http://localhost:5000
INTERNAL_AI_AUTH_TOKEN=change_me_to_a_secure_token

# Authentication & Session Security (Min 32 characters)
# Ký access token của POST /v1/auth/login. Sinh mới: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change_me_to_a_secure_secret_key_with_at_least_32_bytes!
# Thời hạn access token (giây), mặc định 8 giờ
AUTH_TOKEN_TTL_SECONDS=28800

# Integration Connectors (Server-only credentials, never exposed to client)
# Google Analytics 4 & Google Search Console
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GA4_PROPERTY_ID=557397610
# GSC_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GSC_SITE_URL=https://example.com/
# GSC_SITE_VERIFICATION_TOKEN=

# Meta & Social Media Connectors
# Set INTEGRATION_MODE=production only after OAuth credentials are configured.
# FACEBOOK_PAGE_ACCESS_TOKEN=
# FACEBOOK_PAGE_ID=
# META_GRAPH_API_VERSION=v21.0
# FACEBOOK_GRAPH_API_VERSION=v20.0
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_WEBHOOK_VERIFY_TOKEN=
# FACEBOOK_WEBHOOK_WORKSPACE_ID=10000000-0000-4000-8000-000000000001
# INSTAGRAM_BUSINESS_ACCOUNT_ID=
# META_ADS_ACCESS_TOKEN=
# META_AD_ACCOUNT_ID=
# META_AD_CURRENCY=VND
# INTEGRATION_REQUEST_TIMEOUT_MS=20000

# Gemini / AI Service Configuration (shared with services/ai & apps/worker)
# LLM_PROVIDER_MODE=gemini
# GEMINI_API_KEY=
# Optional model for public website advice (server-side only).
# PUBLIC_CHAT_MODEL=gemini-2.5-flash
# SEARXNG_BASE_URL=http://127.0.0.1:18081
# FIRST_PARTY_AUTO_APPROVE_PREFIXES=https://tripc.ai/blog/

# AI Image Generation Configuration (GPU Worker / Flux / Fake)
AI_IMAGE_GENERATION=off
AI_IMAGE_PROVIDER=gpu_worker
IMAGE_STORAGE_PROVIDER=local
LOCAL_STORAGE_BASE_URL=http://localhost:3000

# Telegram Community (server-only; never expose to browser)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_MODE=polling # 'polling' (local dev without public HTTPS/ngrok) or 'webhook'
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_WEBHOOK_WORKSPACE_ID=10000000-0000-4000-8000-000000000001

# TikTok Content Posting API (server-only; never expose to browser)
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=http://localhost:4000/v1/integrations/tiktok/callback
# TIKTOK_ACCESS_TOKEN=
# TIKTOK_OPEN_ID=

# CMS Publishing
# PILOT_CMS_API_KEY=
# Internal worker scheduler; generated by infra/staging/start-agents.ps1. Never NEXT_PUBLIC.
AUTOMATION_INTERNAL_TOKEN=

# Public address of the site, for links in Facebook posts. Unset or local: posts go out without a link.
# PUBLIC_SITE_URL=https://guide.example.com
# Public sites this deployment serves; without it only the development fixtures exist.
# PUBLIC_SITES_JSON=[{"site_id":"tripc-guide","workspace_id":"<workspace uuid>","timezone":"Asia/Ho_Chi_Minh","status":"active"}]

# ---------------- 8 agent merchant (F&B / du lịch) — xem docs/merchant-agents/README.md ----------------
# Mã hóa API key/ token lưu DB (bắt buộc ở production). Ký link ảnh công khai (mặc định dùng AUTH_SECRET).
# TOKEN_ENCRYPTION_KEY=
# MEDIA_SIGNING_SECRET=
# Domain HTTPS công khai của API để Facebook/Instagram/Google tải ảnh đã watermark.
# PUBLIC_API_BASE_URL=https://api.quan-cua-ban.vn
# MEDIA_CACHE_DIR=
# PYTHON_BIN=python

# Multi-LLM router (Gemini → DeepSeek → OpenAI → Claude). Khóa riêng từng quán đặt ở trang Admin LLM.
# GEMINI_MODEL=gemini-2.5-flash
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=            # cần: npm install @anthropic-ai/sdk (trong apps/api)
# CLAUDE_MODEL=claude-opus-5-5

# Google (Agent 2 Drive + Agent 5 Google Maps): OAuth refresh token có scope business.manage + drive.readonly.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
# GOOGLE_API_KEY=               # chỉ đọc thư mục Drive công khai khi chưa có OAuth
# GBP_ACCOUNT_ID=               # tùy chọn: bỏ trống thì tự dò theo link Maps
# GBP_LOCATION_ID=

# Instagram (Agent 4/6/7) — dùng chung Page token và webhook Meta.
# INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Zalo Official Account (Agent 7 nhận/ trả tin nhắn)
# ZALO_APP_ID=
# ZALO_OA_SECRET_KEY=
# ZALO_OA_ACCESS_TOKEN=
# ZALO_WEBHOOK_WORKSPACE_ID=

# Báo cáo ngày & cảnh báo cho chủ quán
# TELEGRAM_OWNER_CHAT_ID=       # mặc định nếu hồ sơ quán chưa có chat id
# RESEND_API_KEY=
# REPORT_EMAIL_FROM="AI Growth OS <bao-cao@quan-cua-ban.vn>"

# Ví trả trước (VietQR) — tài khoản nhận tiền của nền tảng + webhook biến động số dư (SePay/Casso)
# WALLET_BANK_BIN=
# WALLET_BANK_ACCOUNT=
# WALLET_ACCOUNT_NAME=
# PAYMENT_WEBHOOK_SECRET=
# WALLET_ALLOW_MANUAL_CONFIRM=1  # CHỈ staging: cho phép bấm "Xác nhận thử"

# Chỉ demo khi không có Postgres (máy cá nhân). Không bao giờ bật ở staging/production.
# AGOS_OFFLINE_DEMO=1
