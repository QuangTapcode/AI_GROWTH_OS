# ==============================================================================
# AI GROWTH OS — Environment Configuration Template (TQ-09)
# Copy this file to .env and fill in the values
# ==============================================================================

# Server configuration
PORT=4000
# APP_ENV chỉ nhận local | staging | test (src/lib/env.ts)
APP_ENV=local
INTEGRATION_MODE=fake
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# PostgreSQL Database (Host, Port, User, Password, DB Name)
# Local stack (infra/local): user ai_growth_dev, mật khẩu POSTGRES_PASSWORD trong infra/local/.env (URL-encode ký tự đặc biệt)
DATABASE_URL=postgres://ai_growth_dev:change_me@localhost:15432/ai_growth_os

# Internal AI HTTP Service
INTERNAL_AI_URL=http://localhost:5000
INTERNAL_AI_AUTH_TOKEN=change_me_to_a_secure_token

# Authentication & Session Security (Min 32 characters)
# Ký access token của POST /v1/auth/login. Sinh mới: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change_me_to_a_secure_secret_key_with_at_least_32_bytes!
# Thời hạn access token (giây), mặc định 8 giờ
AUTH_TOKEN_TTL_SECONDS=28800

# Integration Connectors (Server-only credentials, never exposed to client)
# Google Analytics 4 & Google Search Console
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GA4_PROPERTY_ID=557397610
# GSC_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GSC_SITE_URL=https://example.com/
# GSC_SITE_VERIFICATION_TOKEN=

# Meta & Social Media Connectors
# Set INTEGRATION_MODE=production only after OAuth credentials are configured.
# FACEBOOK_PAGE_ACCESS_TOKEN=
# FACEBOOK_PAGE_ID=
# FACEBOOK_GRAPH_API_VERSION=v20.0
# INSTAGRAM_BUSINESS_ACCOUNT_ID=
# META_ADS_ACCESS_TOKEN=
# META_AD_ACCOUNT_ID=
# META_AD_CURRENCY=VND
# INTEGRATION_REQUEST_TIMEOUT_MS=20000

# TikTok Content Posting API (server-only; never expose to browser)
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=http://localhost:4000/v1/integrations/tiktok/callback
# TIKTOK_ACCESS_TOKEN=
# TIKTOK_OPEN_ID=

# CMS Publishing
# PILOT_CMS_API_KEY=
# Internal worker scheduler; generated by infra/staging/start-agents.ps1. Never NEXT_PUBLIC.
AUTOMATION_INTERNAL_TOKEN=
