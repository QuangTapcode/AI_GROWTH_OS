# Local-first defaults; copy to .env (git-ignored). No cloud fallback exists.
PORT=5000
APP_ENV=local
LLM_PROVIDER_MODE=fake
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:4b-instruct
EMBEDDING_MODEL=embeddinggemma:latest
EMBEDDING_DIM=768
INTERNAL_AI_AUTH_TOKEN=
# Limits from docs/coordination/PILOT_LIMITS.md
AI_CONTEXT_TOKENS=4096
AI_MAX_INPUT_TOKENS=2800
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_PROVIDER_CALLS=2
AI_MAX_RUN_ATTEMPTS=2
AI_PROVIDER_TIMEOUT_SECONDS=240
AI_JOB_DEADLINE_SECONDS=600
AI_EMBEDDING_TIMEOUT_SECONDS=120
AI_EMBEDDING_JOB_DEADLINE_SECONDS=300
AI_EMBEDDING_BATCH_SIZE=8
AI_MAX_CHUNK_TOKENS=512
AI_MAX_CHUNKS_PER_SOURCE=200
AI_MAX_SOURCE_BYTES=5242880
AI_MAX_REQUEST_BYTES=8388608
AI_MAX_RETRIEVED_CHUNKS=6
AI_URL_FETCH_TIMEOUT_SECONDS=30
# Comma-separated hosts (subdomains included); defaults to the five PILOT_DATASET seed domains.
AI_INGEST_URL_ALLOWLIST=
# Durable run registry (SQLite, single service process). Default: services/ai/var/runs.sqlite3
AI_RUN_STORE_PATH=
