            "description": "Unauthenticated"
          },
          "403": {
            "description": "Inactive/insufficient workspace role"
          },
          "409": {
            "description": "Version/hash/idempotency conflict"
          },
          "422": {
            "description": "Invalid input, stale context/source, missing data or synthetic gate"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
