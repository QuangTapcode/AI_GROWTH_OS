{
  "name": "@ai-growth-os/qq-test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "QQ regression and PostgreSQL integration tests after merging BE",
  "engines": { "node": ">=24.14.1 <25" },
  "scripts": {
    "test": "node scripts/run.mjs",
    "test:db": "node scripts/run.mjs --db",
    "test:unit": "node scripts/run.mjs --unit",
    "test:checks": "node scripts/run.mjs --checks",
    "test:ai": "node scripts/run.mjs --ai",
    "test:ai:live": "node scripts/run.mjs --ai-live",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/pg": "8.11.10",
    "pg": "8.23.1",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  }
}
